        {
          "name": "Create a transaction",
          "id": "5d8466f5-9ca5-4d41-8784-d6d93713f7d5",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
