                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount_in_cents\": \"<integer>\",\n  \"currency\": \"<string>\",\n  \"customer_email\": \"<string>\",\n  \"acceptance_token\": \"<string>\",\n  \"reference\": \"<string>\",\n  \"payment_method\": {\n    \"type\": \"<string>\",\n    \"token\": \"<string>\",\n    \"installments\": \"<integer>\"\n  },\n  \"signature\": \"<string>\",\n  \"payment_source_id\": \"<integer>\"\n}",
