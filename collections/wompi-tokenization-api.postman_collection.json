          "name": "Create a Nequi token (subscribe)",
          "request": {
            "name": "Create a Nequi token (subscribe)",
            "description": {
              "content": "Starts Nequi enrollment for a phone number; the user approves the subscription in the Nequi app. Returns a Nequi token (nequi_...) whose status is polled before it can be charged.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "tokens",
                "nequi"
              ],
              "host": [
                "{{baseUrl}}"
